# 自部署默认推荐开启：跳过作者官方账号/激活码系统，使用本地单机账号。
# 作者自己的 Netlify 链接版不要设置这个变量。
NEXT_PUBLIC_SELF_HOSTED_MODE=true

# 可选：如果你要启用自己的 Supabase 云端功能，请填写自己的项目，不要使用作者的项目。
# 需要先在 Supabase SQL Editor 执行 docs/*.sql 中对应功能的建表脚本。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 独家特调（酒材页 / 配方页）专用的独立 Supabase 项目。特调的表、RPC 与全部读写只认
# 这两个变量，不会回退到上面的主库；不填就等于特调云端未开张。
# 需要先在这个项目的 SQL Editor 执行 docs/mixology-supabase.sql。
MIXOLOGY_SUPABASE_URL=
MIXOLOGY_SUPABASE_SERVICE_ROLE_KEY=

# 可选：现实桥“邮件自动执行”实验模式。先在 Resend 验证自己的发信域名，
# 再配置 API Key 和该域名下的发件地址。验证码密钥建议使用独立随机长字符串。
RESEND_API_KEY=
REALITY_BRIDGE_EMAIL_FROM="Float Reality Bridge <bridge@your-domain.example>"
SHORTCUT_EMAIL_VERIFICATION_SECRET=
# 可选：账号门禁签名密钥。启用账号系统时建议设置为随机长字符串。
ACCOUNT_GATE_SECRET=

# 可选：成年审核/激活码后台管理密钥。
VERIFY_ADMIN_KEY=

# 可选：应用市场审核后台密钥。不填时会回退使用 VERIFY_ADMIN_KEY。
APP_MARKET_ADMIN_KEY=

# 可选：启用便签墙实时刷新才需要。注意 NEXT_PUBLIC_* 会公开到浏览器，不要放 service_role。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 可选：第三方能力的服务端兜底 key。一般不用填——用户可在应用内自行填写
# （Tripo 在世界搭建界面，ImgBB 在生图/图床设置）。
TRIPO_API_KEY=
IMGBB_API_KEY=
WEIXIN_PROXY=
NEXT_PUBLIC_IMAGE_GEN_PROXY_URL=
# 可选：网易云音乐 API（NeteaseCloudMusicApi 兼容实例）上游地址。
# 音乐请求默认经本站 /api/music/netease 服务端代理转发，所以这里填**服务端**能访问到的地址。
# 经代理后不再受浏览器证书策略约束，自签名 HTTPS 实例也能正常工作。
#
# 不填也行：留空时代理按「用户在设置里填的地址 → 本变量 → 从请求 Host 推导」依次回退，
# 最后一层用浏览器访问的主机名换上 NEXT_PUBLIC_NETEASE_API_PORT 端口，同机部署通常正好命中。
NETEASE_API_BASE=
# 可选：推导上游地址时替换成的端口（默认 4001）。上游换端口就改这里，不用动代码。
# 客户端与服务端读**同一个**变量（浏览器里读环境变量必须带 NEXT_PUBLIC_ 前缀），
# 所以它只装端口、不装地址，不算秘密。旧名 NETEASE_API_DERIVE_PORT 仍兼容读取。
NEXT_PUBLIC_NETEASE_API_PORT=4001
# 可选：上游用自签名证书时置 true（默认 true）跳过服务端这一跳的证书校验。
# 置 false 则要求上游证书受信任。注意 NETEASE_API_INSECURE 是服务端变量，
# 不会打包进浏览器——置成 NEXT_PUBLIC_ 前缀会把「跳过证书校验」暴露给客户端，别那么写。
NETEASE_API_INSECURE=true
# 可选：旧版字段。仅作 NETEASE_API_BASE 的回退，建议改用上面的变量。
# 注意它是 NEXT_PUBLIC_ 开头的，会被打包进浏览器代码、完全公开，不要写内网地址。
NEXT_PUBLIC_DEFAULT_NETEASE_API_BASE=
# 可选：仅当你更换过默认音乐 API 地址时需要。旧地址填这里（逗号分隔），
# 老用户浏览器里存的旧地址会自动迁移到当前默认。
NEXT_PUBLIC_LEGACY_NETEASE_API_BASES=
# 可选：网易云 API 的 realIP 参数（海外部署解锁地区限制用）。
NEXT_PUBLIC_NETEASE_REAL_IP=
# 可选：设为 true 时跳过服务端代理，恢复浏览器直连（需上游有受信任证书且配好 CORS）。
NEXT_PUBLIC_NETEASE_MUSIC_DIRECT=
